# Copy to .env and fill in. Never put a real key in this file — it is committed.
GEMINI_API_KEY=your-key-here

# Optional overrides (config.py defaults shown). These are every variable
# load_settings() reads; anything else here has no effect.
# EMBED_BACKEND=local              # "local" (BGE, needs torch) | "gemini"
# EMBED_MODEL=gemini-embedding-001
# LOCAL_EMBED_MODEL=BAAI/bge-small-en-v1.5
# GEN_MODEL=gemini-3.7-flash
# RERANK=false                     # eval arm only; no serving-path caller
# RERANK_MODEL=BAAI/bge-reranker-base
# DATA_ROOT=data
# LOG_LEVEL=INFO
